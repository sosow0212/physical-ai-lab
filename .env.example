# Physical AI Lab — 환경 변수 템플릿
# 사용법: cp .env.example .env 후 값 입력 (특히 LLM_API_KEY)
# 컨테이너 기준 기본값이며, 호스트에서 직접 실행 시 각 주소를 localhost로 바꾼다.

# ── 앱 ──
APP_ENV=dev
LOG_LEVEL=INFO

# ── 데이터스토어 (컨테이너 내부 주소) ──
MONGO_URI=mongodb://mongo:27017/pal
REDIS_URL=redis://redis:6379/0
MILVUS_URI=http://milvus:19530
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=palpass123

# ── Kafka (Redpanda) ──
# 컨테이너 내부는 29092, 호스트에서 접근 시 localhost:9092
KAFKA_BOOTSTRAP=redpanda:29092
KAFKA_GROUP_ID=pal-worker

# ══════════ AI 설정 ══════════
# [채팅 LLM] GLM Coding Plan(z.ai) — 구독 전용 엔드포인트(/api/coding/paas/v4) 사용
# provider: glm(GLM Coding Plan·z.ai) | openai | ollama
# 세 provider 모두 OpenAI 호환 API라서 아래 값만 바꾸면 전환된다.
LLM_PROVIDER=glm
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4.6
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# [임베딩] 로컬 Ollama bge-m3 — Coding Plan에 임베딩 API가 없어 로컬로 서빙한다.
# provider: ollama(로컬·기본) | openai(호환 API로 교체 시)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ── 검색 / 청킹 ──
RETRIEVAL_TOP_K=8
CHUNK_MAX_CHARS=900
CHUNK_OVERLAP_CHARS=150

# ── 업로드 스토리지 ──
UPLOAD_DIR=/data/uploads
